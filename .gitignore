# The old Eclipse editor: a separate clone of github.com/bloqqi/bloqqi-editor,
# kept here only as a reference (docs/editor-spec.md describes it).
/bloqqi-editor/

# Build outputs
/build/
/lib/
/client/node_modules/
/client/dist/
/client/test-results/
/client/playwright-report/

# Default workspace of "ant run" and of Docker: only the empty folder is in
# git; its files are yours (an empty workspace gets the compiler's examples).
/workspace/*
!/workspace/.gitkeep
